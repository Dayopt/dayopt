# pre-commit: secret scan + auto format（provider 非依存の git hook）
#
# gitleaks は staged 差分のみを見る（速度予算: 数秒）。CI（docs-guard.yml）は
# バージョンを sha256 で pin しているが、ここは意図的に固定しない —
# ローカルは「CI に着く前に無料で落とす」フィルタで、CI が最終網のまま。
# バージョン強制は brew upgrade のたびに壊れるブリトルさの方が割に合わない。
# 詳細: docs/operations/security.md、AGENTS.md §PR / git 運用
if ! command -v gitleaks > /dev/null 2>&1; then
  # 非対話環境（CI 変数設定 or stdin が TTY でない）では hard fail にしない。
  # brew が無い環境（Claude Code の cloud session など）でも agent は
  # commit する。ここを hard fail のままにすると、--no-verify
  # も agent には禁止済みのため全 commit が回復不能に詰まる（2026-08-24、
  # merge 前クロスレビュー risk-reviewer 指摘）。CI（docs-guard.yml）が
  # secret 検出の最終網であるため、この環境だけ skip しても検出自体は
  # 失われない。
  if [ -n "${CI:-}" ] || [ ! -t 0 ]; then
    echo "⚠ 警告: gitleaks が見つかりません。非対話環境のため secret scan を skip して commit を続行します（CI の docs-guard.yml が最終網です。詳細: docs/operations/security.md）。" >&2
  else
    echo "✗ gitleaks が見つかりません。'brew install gitleaks' でインストールしてください（docs/operations/security.md 参照）。" >&2
    exit 1
  fi
else
  # --redact 必須: 実値を出力すると、この repo で作業する Claude セッション
  # 自身の transcript に秘密情報が写ってしまう。
  if ! gitleaks protect --staged --source . --redact; then
    echo "✗ commit を中断しました（staged 差分に secret らしき文字列が検出されました）。誤検知なら .gitleaks.toml の値ベース allowlist（docs/operations/security.md の追加手順を参照）を検討してください。" >&2
    exit 1
  fi
fi

npx lint-staged
