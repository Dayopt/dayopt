# pre-push: main 保護 + push 前の pause point（provider 非依存）
#
# git レベルの hook なので Claude / 人間 / wrapper script のすべてに効く。
# stdin には push される ref が <local_ref> <local_sha> <remote_ref> <remote_sha>
# の形で 1 行ずつ渡される。

ZERO=0000000000000000000000000000000000000000
HAS_BRANCH_UPDATE=0
PUSHED_SHAS=''

# stdin は 1 度しか読めない単一消費ストリーム。下の while ループに加えて
# pre-push-diff.mjs（#2432、差分ゼロ push の自動スキップ判定）にも同じ内容を
# 渡す必要があるため、いったん一時ファイルへ退避する。trap で確実に削除する。
#
# `cat` 自体の失敗（TMPDIR の容量不足・quota 超過等）を検知しないと、空/部分的な
# ref リストのまま後続処理が「続行」してしまい、main への直接 push 禁止と
# DO-CONFIRM・実行ゲートが丸ごと skip されて**成功終了する**（push前反証レビュー
# 指摘・P1、PR #2445）。`mktemp` と同じく fail-closed にする。
PUSH_INPUT_FILE=$(mktemp) || {
  echo "✗ push 入力の退避に失敗しました（mktemp）。TMPDIR を確認してください。" >&2
  exit 1
}
trap 'rm -f "$PUSH_INPUT_FILE"' EXIT
cat > "$PUSH_INPUT_FILE" || {
  echo "✗ push 入力の退避に失敗しました（cat。TMPDIR の容量・quota を確認してください）。" >&2
  exit 1
}

while read -r _local_ref local_sha remote_ref _remote_sha; do
  # main への直接 push を禁止する。マージは PR + pnpm branch:finish 経由に限定する。
  # GitHub 側の merge gate は main の ruleset（required status checks / review thread
  # resolution 等。docs/engineering/infra.md §merge gate）で、GitHub Team の private repo
  # でも強制される。ただし ruleset が直接 push をどこまで拒否するかは repo の docs に
  # 書かれていない（実状は gh api repos/Dayopt/dayopt/rulesets/6790553 が正）ため、
  # ruleset の設定に依存せず push 前にローカルで止める防御としてこの hook を残す
  # （tag push や他 branch は通す）。
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✗ main への直接 push は禁止です。PR を作成し pnpm branch:finish でマージしてください。" >&2
    exit 1
  fi

  # branch の更新だけを pause 対象にする（削除・tag は対象外。
  # branch:finish の掃除 push を巻き込まないため）
  case "$remote_ref" in
    refs/heads/*)
      if [ "$local_sha" != "$ZERO" ]; then
        HAS_BRANCH_UPDATE=1
        # marker の鍵は「実際に push される ref の集合」から作る。HEAD を使うと、
        # checkout していない branch の push や複数 ref の push で鍵がずれ、
        # 別の commit set が pause を素通りする（あるいは誤った鍵で 1 回止まる）
        PUSHED_SHAS="$PUSHED_SHAS$remote_ref $local_sha
"
      fi
      ;;
  esac
done < "$PUSH_INPUT_FILE"

# --- pause point: push 前の DO-CONFIRM ---
# commit set ごとに 1 回だけ止め、確認の観点を出す。再実行すれば通る。
# これはスピードバンプであってゲートではない（答えたかどうかは機械では
# 検証できない）。項目は再発履歴のあるものだけ・観点名のみ。正本は
# AGENTS.md §レーン運用（push 前セルフレビュー）。
# 検証は /gardening のステップ 5。項目を 1 つ足すときは 1 つ削る。
#
# 差分ゼロ push（空コミットのみ。着手時 Draft PR の初回 push 等）は 4 点が
# 機械的に「該当なし」で確定しており、bump を出し続けると本当に確認が要る
# push での回答の質を下げる（#2432）。tracked ファイルの差分が無い push
# だけ、判定 script（pre-push-diff.mjs）の結果に従って自動スキップする。
# **判定不能・失敗・タイムアウトはすべて no-skip（＝通常どおり DO-CONFIRM を
# 出す）側に倒れる設計**（pre-push-diff.mjs 冒頭コメント参照）。
if [ "$HAS_BRANCH_UPDATE" = "1" ]; then
  SKIP_DECISION=$(node scripts/hooks/pre-push-diff.mjs < "$PUSH_INPUT_FILE" 2>/dev/null || echo no-skip)
  if [ "$SKIP_DECISION" = "skip" ]; then
    echo "→ 差分ゼロ push のため DO-CONFIRM をスキップします（#2432）" >&2
  else
    PUSH_KEY=$(printf '%s' "$PUSHED_SHAS" | git hash-object --stdin 2>/dev/null || echo unknown)
    MARKER_DIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)/dayopt-push-confirm"
    if [ ! -f "$MARKER_DIR/$PUSH_KEY" ]; then
      mkdir -p "$MARKER_DIR" && : > "$MARKER_DIR/$PUSH_KEY"
      find "$MARKER_DIR" -type f -mtime +30 -delete 2>/dev/null
      cat >&2 <<'CONFIRM'
PAUSE: push 前の確認（この commit set では初回。4 点に答えてから再実行する。
該当なしの項目は「該当なし」と言い切る。黙って通さない）

1. index は意図どおりか（git diff --cached を見たか）
2. 直前の修正コミットが新しい穴を開けていないか
3. auth / RLS / billing / migration / 公開契約 / cross-feature を含む diff なら、
   セルフレビューの根拠と、PR 作成後に GitHub の `@codex review` を依頼する段取りを確認したか
   （追加 reviewer は起動しない）
4. 配線と不等式は確認したか（env の受け渡し、timeout / 予算などの定数関係）

なぜこの 4 点か: AGENTS.md §レーン運用（push 前セルフレビュー）
CONFIRM
      exit 1
    fi
  fi
fi

# --- 実行ゲート（2026-08-24, #2359）: pause point 確認後に走る機械検証 ---
# push 前の pause point（DO-CONFIRM 表示、または差分ゼロ push の自動スキップ、
# #2432）を経た push でのみ到達する。marker の有無では判定しない —
# 差分ゼロ push は marker を作らずスキップするため、「marker が既にある」は
# もう到達条件ではない（push前反証レビュー指摘・P3、PR #2445）。
# HAS_BRANCH_UPDATE=0（tag push・branch 削除）は対象外 — branch:finish の
# 掃除 push を巻き込まないため（上の pause point と同じ理由）。
#
# これは CI Static Checks の代替ではない。`pnpm check` 相当のフルセットではなく
# affected スコープの高速フィルタで、フックが通っても CI は必ず走る
# （フックは CI 前に無料で落とす係）。
#
# test:run（turbo タスク）は対象に含めない。apps/product・apps/web の
# localStorage 依存テストが Node 26 環境で `Cannot read properties of
# undefined (reading 'clear'/'setItem')` を起こす既知の環境問題があり
# （CI の Node 24 では pass する、本チケットと無関係の pre-existing 事象。
# clean HEAD で再現確認済み）、これを含めると push 自体が環境依存で
# 恒常的に失敗しうる。dispatch の escape hatch（「数分を超える／信頼できない
# なら test を pre-push から CI へ残す」）に従い、typecheck/lint に絞る。
if [ "$HAS_BRANCH_UPDATE" = "1" ]; then
  TURBO_TASKS="typecheck lint"

  # ローカルの origin/main が古いと affected 判定がずれうるが、over-scope
  # 方向（対象が増える）の安全側リスクとして許容する。
  #
  # root/scripts のみの変更（本チケット自身の diff がまさにこれ）では
  # --filter=...[origin/main] の選択パッケージが 0 件になり、affected run が
  # 何もせず成功する no-op になる実測を確認済み（2026-08-24）。0 件の時は
  # full run へフォールバックする。
  AFFECTED_COUNT=$(npx turbo run $TURBO_TASKS --filter="...[origin/main]" --dry=json 2>/dev/null | jq '.packages | length' 2>/dev/null)

  if [ -z "$AFFECTED_COUNT" ] || [ "$AFFECTED_COUNT" = "0" ] || [ "$AFFECTED_COUNT" = "null" ]; then
    echo "→ affected package 選択が空のため full run にフォールバックします（root/scripts 変更等）" >&2
    if ! npx turbo run $TURBO_TASKS; then
      echo "✗ typecheck/lint が失敗しました。push を中断します。" >&2
      exit 1
    fi
  else
    if ! npx turbo run $TURBO_TASKS --filter="...[origin/main]"; then
      echo "✗ typecheck/lint（affected）が失敗しました。push を中断します。" >&2
      exit 1
    fi
  fi

  # turbo タスクに乗っていない検証（scripts/ の typecheck・test、format）。
  # test:scripts は browser API に依存しないため上記の環境問題を持たず、
  # 単独で信頼できることを確認済み（1096/1096 pass、複数回実測）。
  if ! pnpm typecheck:scripts; then
    echo "✗ typecheck:scripts が失敗しました。push を中断します。" >&2
    exit 1
  fi
  if ! pnpm test:scripts; then
    echo "✗ test:scripts が失敗しました。push を中断します。" >&2
    exit 1
  fi
  if ! pnpm format:check; then
    echo "✗ format:check が失敗しました。push を中断します。" >&2
    exit 1
  fi
fi
