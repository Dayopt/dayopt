coverage/

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/
apps/*/node_modules/
packages/*/node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# ESLint Cache
.eslintcache

# Performance logs
performance-*.log


# Validation artifacts
.violations.json
/quality-reports/

