*.tgz

# Yarn Integrity file
.yarn-integrity
yarn.lock

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Turborepo cache
.turbo/

# Nuxt.js build / generate output
.nuxt
dist

