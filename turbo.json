{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.packages.mjs", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**", "dist/**"],
      "env": [
        "ANALYZE",
        "BILLING_ENFORCED",
        "CALENDAR_TOKEN_ENCRYPTION_KEY",
        "CI",
        "CRON_SECRET",
        "GOOGLE_CALENDAR_*",
        "GOOGLE_SITE_VERIFICATION",
        "MCP_*",
        "OAUTH_*",
        "POSTHOG_*",
        "NEXT_PUBLIC_POSTHOG_*",
        "PRIVACY_PROTECTION_MODE",
        "RECOVERY_CODE_PEPPER",
        "RESEND_*",
        "SENTRY_*",
        "SKIP_AUTH_IN_DEV",
        "STRIPE_*",
        "SUPABASE_*",
        "TURNSTILE_*",
        "UPSTASH_*",
        "VERCEL_BRANCH_URL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_TARGET_ENV",
        "VERCEL_URL",
        "YAHOO_VERIFICATION",
        "YANDEX_VERIFICATION"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test:run": {},
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
