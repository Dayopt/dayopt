}

model {
  concept c_timeblock 'Timeblock' {
    description 'カレンダー上の時間ブロック。予定 / 記録の総称'
    metadata { glossary 'timeblock' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_plan 'Plan' {
    description 'これからやる時間の宣言。時間軸のどこにでも置ける独立エンティティ'
    metadata { glossary 'plan' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_record 'Record' {
    description '実際に使った時間。予定とは独立して保存し、未来には終われない'
    metadata { glossary 'record' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_activity 'Activity' {
    description '予定と記録の単位。最も具体的な分類で、無限に増えてよい'
    metadata { glossary 'activity' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_category 'Category' {
    description '所属の主軸。1 アクティビティは最大 1 カテゴリー。色とアイコンを持つ'
    metadata { glossary 'category' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_segment 'Segment' {
    description '旧: 分析用の保存されたクエリ。2026-09-15 に UI / tRPC / MCP から撤去し、/report のアクティビティ単位フィルタへ置き換えた。DB テーブルだけが残る'
    metadata { glossary 'segment' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_plan-template 'Plan template' {
    description '1 日の予定の並びを保存して別の日へ適用する仕組み'
    metadata { glossary 'plan-template' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_review 'Review' {
    description 'ページ名・機能名。route は /report、i18n namespace も report'
    metadata { glossary 'review' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_inspector 'Inspector' {
    description 'タイムブロックをクリックした時に開く詳細パネル'
    metadata { glossary 'inspector' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_archive 'Archive' {
    description 'アクティビティ / カテゴリーを一覧から隠す。過去の記録は残る（削除ではない）'
    metadata { glossary 'archive' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_trash 'Trash' {
