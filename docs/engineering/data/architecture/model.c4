    metadata { glossary 'trash' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_confirm-day 'Confirm day' {
    description '過去の予定をまとめて記録へ変換する操作'
    metadata { glossary 'confirm-day' layer 'ui' }
    link ../../../../scripts/lib/glossary/terms.ts
  }
  concept c_fulfillment 'Fulfillment' {
