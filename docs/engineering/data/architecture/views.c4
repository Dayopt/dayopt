views {
  view index {
    title 'Dayopt Architecture Map'
    description '概念と feature。概念を選ぶと対応する実装の view へ辿れる'
    include * where kind is concept
    include * where kind is feature
    autoLayout LeftRight
  }
  view features {
    title 'Feature DAG（実 import）'
    include * where kind is feature
    autoLayout TopBottom
  }
  view data {
    title 'DB テーブルと FK'
    include * where kind is table
    autoLayout LeftRight
  }
  view mcp {
    title 'MCP tool と概念'
    include * where kind is mcptool
    include * where kind is concept
    autoLayout LeftRight
  }
  view api {
    title 'HTTP route と定期実行'
    include * where kind is httproute
    include * where kind is schedule
    autoLayout LeftRight
  }
  view unmapped {
    title '概念を足す候補（語彙を持たない層は除く）'
    include * where tag is #unmapped
    autoLayout TopBottom
  }
