{
  "name": "@dayopt/product",
  "version": "0.27.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "src/lib/styles/globals.css"
  ],
  "scripts": {
    "dev": "bash ../../scripts/tasks/dev-with-op.sh",
    "dev:raw": "NODE_OPTIONS='--max-old-space-size=12288' next dev",
    "dev:op": "pnpm dev",
    "typecheck:op": "op run --env-file=../../.op-env.agent -- pnpm typecheck",
    "env:check": "op run --env-file=../../.op-env.agent -- pnpm exec tsx ../../scripts/tasks/env/check-env.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "lint:i18n": "tsx ../../scripts/tasks/check-i18n-integrity.ts",
    "copy:check": "tsx ../../scripts/tasks/check-glossary.ts",
    "i18n:add-locale": "tsx ../../scripts/tasks/add-locale.ts",
    "docs:check": "tsx ../../scripts/tasks/validate-doc-references.ts",
    "api:spec": "NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=dummy SUPABASE_SECRET_KEY=dummy tsx ../../scripts/tasks/generate-api-spec.ts",
    "api:spec:check": "NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=dummy SUPABASE_SECRET_KEY=dummy tsx ../../scripts/tasks/generate-api-spec.ts --check",
    "license:check": "license-checker --production --excludePrivatePackages --onlyAllow \"$(cat .licensrc.json | jq -r .onlyAllow)\"",
    "license:check-risks": "tsx ../../scripts/tasks/check-license-risks.ts",
    "license:audit": "license-checker --production --summary",
    "license:credits:check": "tsx ../../scripts/tasks/generate-licenses.ts --check",
    "generate-licenses": "tsx ../../scripts/tasks/generate-licenses.ts",
    "perf:lighthouse": "lhci autorun",
    "quality:full": "pnpm lint && pnpm license:check && pnpm perf:lighthouse && pnpm typecheck",
    "quality:deadcode": "knip --config knip.json --reporter json",
    "quality:deadcode:ci": "knip --config knip.json --exclude files,unlisted,binaries",
    "test": "vitest --project unit --project unit-dom",
    "test:run": "vitest --project unit --project unit-dom run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --project unit --project unit-dom run --coverage",
    "test:watch": "vitest --watch",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "db:reset": "supabase db reset --local",
    "db:reset-linked:unsafe": "supabase db reset --linked",
    "db:seed": "../../scripts/tasks/seed-dev-data.sh",
    "db:seed:identity": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f ../../supabase/local/mcp-identity-seed.sql",
    "db:fresh": "pnpm db:reset && pnpm db:seed:identity && pnpm db:seed",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test src/lib/test/e2e/smoke.spec.ts src/lib/test/e2e/review-granularity.spec.ts",
    "test:e2e:critical": "playwright test src/lib/test/e2e/critical-path.spec.ts src/lib/test/e2e/auth.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "i18n:check": "tsx src/lib/i18n/scripts/check-keys.ts",
    "i18n:unused": "tsx src/lib/i18n/scripts/find-unused.ts",
    "deps:check": "pnpm audit --prod && ncu --errorLevel 2",
    "deps:circular": "madge --circular --ts-config ./tsconfig.json --extensions ts,tsx src/",
    "size:budget": "tsx ../../scripts/tasks/check-bundle-budget.ts",
    "verify:bundle": "node ../../scripts/tasks/check-client-bundle-secrets.mjs && tsx ../../scripts/tasks/check-bundle-budget.ts --fail",
    "probe:setup": "tsx src/lib/test/e2e/usability-probe-setup.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "security:check": "pnpm audit --audit-level=moderate",
    "security:check:production": "pnpm audit --prod --audit-level=high",
    "storybook:coverage": "tsx ../../scripts/tasks/check-story-coverage.ts",
    "test:mcp:conformance": "NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=dummy SUPABASE_SECRET_KEY=dummy MCP_CANONICAL_RESOURCE_URI=https://mcp.dayopt.app NODE_OPTIONS='--conditions=react-server' tsx scripts/mcp-conformance.ts"
  },
  "dependencies": {
    "@dayopt/billing": "workspace:*",
    "@dayopt/components": "workspace:*",
    "@dayopt/config": "workspace:*",
    "@dayopt/foundations": "workspace:*",
    "@dayopt/i18n": "workspace:*",
    "@dayopt/observability": "workspace:*",
    "@hookform/resolvers": "^3.10.0",
    "@marsidev/react-turnstile": "catalog:",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/nextjs": "catalog:",
    "@supabase/auth-js": "^2.110.7",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/query-persist-client-core": "^5.101.2",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "catalog:",
    "@upstash/ratelimit": "catalog:",
    "@upstash/redis": "catalog:",
    "@vercel/analytics": "catalog:",
    "@vercel/speed-insights": "catalog:",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-dropzone": "^14.4.1",
    "react-email": "^6.9.0",
    "react-hook-form": "catalog:",
    "resend": "catalog:",
    "server-only": "catalog:",
    "sonner": "catalog:",
    "stripe": "^20.4.1",
    "superjson": "^2.2.6",
    "zod": "^3.25.76",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:tooling",
    "@axe-core/react": "catalog:tooling",
    "@lhci/cli": "catalog:tooling",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@next/bundle-analyzer": "catalog:tooling",
    "@next/env": "^16.3.3",
    "@playwright/test": "catalog:tooling",
    "@storybook/addon-a11y": "catalog:tooling",
    "@storybook/addon-docs": "catalog:tooling",
    "@storybook/addon-mcp": "catalog:tooling",
    "@storybook/addon-vitest": "catalog:tooling",
    "@storybook/nextjs-vite": "catalog:tooling",
    "@tailwindcss/postcss": "catalog:tooling",
    "@testing-library/dom": "catalog:tooling",
    "@testing-library/jest-dom": "catalog:tooling",
    "@testing-library/react": "catalog:tooling",
    "@testing-library/user-event": "catalog:tooling",
    "@types/node": "^24.13.3",
    "@types/qrcode": "catalog:tooling",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "catalog:tooling",
    "@vitest/browser-playwright": "catalog:tooling",
    "@vitest/coverage-istanbul": "catalog:tooling",
    "@vitest/ui": "catalog:tooling",
    "@vueless/storybook-dark-mode": "catalog:tooling",
    "axe-core": "^4.12.1",
    "babel-plugin-react-compiler": "catalog:tooling",
    "eslint": "catalog:tooling",
    "eslint-config-next": "catalog:tooling",
    "eslint-plugin-storybook": "catalog:tooling",
    "eslint-plugin-tailwindcss": "catalog:tooling",
    "glob": "catalog:",
    "happy-dom": "catalog:tooling",
    "husky": "catalog:tooling",
    "knip": "catalog:tooling",
    "license-checker": "catalog:tooling",
    "madge": "catalog:tooling",
    "npm-check-updates": "catalog:tooling",
    "playwright": "catalog:tooling",
    "postcss": "catalog:tooling",
    "prettier": "catalog:tooling",
    "sharp": "catalog:tooling",
    "storybook": "catalog:tooling",
    "tailwindcss": "catalog:tooling",
    "tsx": "catalog:tooling",
    "tw-animate-css": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling",
    "zod-to-json-schema": "^3.25.2"
  }
}
