{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "product",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@dayopt/storybook", "storybook"],
      "port": 6006
    },
    {
      "name": "storybook-worktree",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@dayopt/storybook", "exec", "storybook", "dev", "-p", "6007"],
      "port": 6007
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@dayopt/web", "dev", "--port", "3100"],
      "port": 3100
    }
  ]
}
